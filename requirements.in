# Direct dependencies only.  The pinned set is requirements.txt, compiled from
# this file with `uv pip compile requirements.in -o requirements.txt`.

# The reader.  Server-rendered HTML; uvicorn's standard extras bring uvloop and
# httptools (the flags the deploy uses) and watchfiles for --reload.
fastapi
uvicorn[standard]
jinja2
# The visit counter: DB-IP's City Lite database, read by mmap.  Country and
# city are looked up as a request is counted, and the IP is then dropped.
maxminddb

# The build.  fontTools subsets UB Goudy to the corpus; the woff extra brings
# brotli, without which it cannot write WOFF2.
fonttools[woff]
