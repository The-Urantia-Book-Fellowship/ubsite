# Install as root:root 0644 at /etc/nginx/sites-available/ubsite.ddns.net, then:
#
#     sudo ln -s /etc/nginx/sites-available/ubsite.ddns.net /etc/nginx/sites-enabled/
#     sudo nginx -t && sudo systemctl reload nginx
#
# Two rules this file must not break:
#
#   1. `no-sni-default` is the ONLY default_server on 443. Do not add another
#      here -- nginx refuses to start with a duplicate.
#   2. ubsite.ddns.net must not also appear in ulib.ddns.net's server_name. Two
#      blocks claiming one name means the first parsed wins, silently.
#
# There is NO allow/deny: this site is meant to be public, so it carries its own
# protections, explicitly, below.

limit_req_zone $binary_remote_addr zone=ubsite_search:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=ubsite_api:10m rate=40r/m;

server {
    listen 80;
    server_name ubsite.ddns.net;
    # Certbot's HTTP-01 challenge needs this to stay reachable; the existing
    # cert renews the same way, which is why port 80 is forwarded at all.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ubsite.ddns.net;

    ssl_certificate     /etc/letsencrypt/live/ubsite.ddns.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ubsite.ddns.net/privkey.pem;

    # The site accepts no uploads of any kind.
    client_max_body_size 1k;

    # Search is the only route that can cost real work; everything else is an
    # indexed SELECT. 30/min with a burst is generous for a reader and useless
    # for a scraper.
    location /search {
        limit_req zone=ubsite_search burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    # The text API (ubsite/api.py).  A site keeping its copy in step asks once a
    # day, one request, and an unchanged reply is a 304: far less than a person
    # searching.  40/min is for while the first sites are being built against it
    # (Tigran, 2026-10-11); it is to come down, to 10.  The whole text is 3 MB,
    # so what this stops is a program asking for it from version 0 in a loop,
    # and the burst is small for the same reason.  Every address behind one NAT
    # shares the bucket: testing from home shares it with this LAN.  /api, the page that documents it,
    # is not under /api/ and stays with the rest.
    location /api/ {
        limit_req zone=ubsite_api burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }
    # Without this, nginx answers /api with a 301 to /api/: a prefix location
    # ending in a slash, with proxy_pass, does that to the same URI without it.
    # The app sends /api/ back to /api with a 307, so a browser went round the
    # two until the rate limit above refused it with a 429.  An exact match is
    # nginx's own documented way out.
    location = /api {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    # Static names are NOT content-addressed: /static/ub.css is the same URL
    # after every deploy. So browsers must revalidate. The app sends an ETag and
    # answers 304 when nothing changed, which makes that one small request each.
    # `immutable` belongs here only once the names carry a hash.
    location /static/ {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        add_header Cache-Control "no-cache" always;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }
}
