# Install as root:root 0644 at /etc/nginx/sites-available/ubsite.ddns.net, then:
#
#     sudo ln -s /etc/nginx/sites-available/ubsite.ddns.net /etc/nginx/sites-enabled/
#     sudo nginx -t && sudo systemctl reload nginx
#
# Two rules this file must not break:
#
#   1. `no-sni-default` is the ONLY default_server on 443. Do not add another
#      here -- nginx refuses to start with a duplicate.
#   2. ubsite.ddns.net must not also appear in ulib.ddns.net's server_name. Two
#      blocks claiming one name means the first parsed wins, silently.
#
# There is NO allow/deny: this site is meant to be public, so it carries its own
# protections, explicitly, below.

limit_req_zone $binary_remote_addr zone=ubsite_search:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=ubsite_api:10m rate=40r/m;
limit_req_zone $binary_remote_addr zone=ubsite_board:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ubsite_stats:10m rate=10r/m;

# Where nginx keeps the offline copy's chunks it has sent once (the location
# for /offline/c/ below).  The directory is nginx's own, made by it as it
# starts (and by `nginx -t`): it cannot read ~/ubsite/var, the home directory
# being closed to www-data, and nothing there changes for this.  It makes the
# last level of the path only, which is why this is not /var/cache/nginx/…,
# a directory neither host has.  Two things keep it from growing, both the
# work of nginx's cache manager: a chunk nobody has asked for in 60 days is
# deleted (inactive), and past 600 MB those asked for longest ago go first
# (max_size).  A megabyte of keys is about 8,000 chunks; a build has under 500.
proxy_cache_path /var/cache/ubsite-nginx levels=1:2 keys_zone=ubsite_chunks:1m
                 max_size=600m inactive=60d use_temp_path=off;

server {
    listen 80;
    server_name ubsite.ddns.net;
    # Certbot's HTTP-01 challenge needs this to stay reachable; the existing
    # cert renews the same way, which is why port 80 is forwarded at all.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ubsite.ddns.net;

    ssl_certificate     /etc/letsencrypt/live/ubsite.ddns.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ubsite.ddns.net/privkey.pem;

    # The site accepts no uploads of any kind; the quiz's board alone takes a
    # little more, in its own two locations below.
    client_max_body_size 1k;

    # Search is the only route that can cost real work; everything else is an
    # indexed SELECT. 30/min with a burst is generous for a reader and useless
    # for a scraper.
    location /search {
        limit_req zone=ubsite_search burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    # The text API (ubsite/api.py).  A site keeping its copy in step asks once a
    # day, one request, and an unchanged reply is a 304: far less than a person
    # searching.  40/min is for while the first sites are being built against it
    # (Tigran, 2026-10-11); it is to come down, to 10.  The whole text is 3 MB,
    # so what this stops is a program asking for it from version 0 in a loop,
    # and the burst is small for the same reason.  Every address behind one NAT
    # shares the bucket: testing from home shares it with this LAN.  /api, the page that documents it,
    # is not under /api/ and stays with the rest.
    location /api/ {
        limit_req zone=ubsite_api burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }
    # Without this, nginx answers /api with a 301 to /api/: a prefix location
    # ending in a slash, with proxy_pass, does that to the same URI without it.
    # The app sends /api/ back to /api with a 307, so a browser went round the
    # two until the rate limit above refused it with a 429.  An exact match is
    # nginx's own documented way out.
    location = /api {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    # The quiz's board (ubsite/board.py), which ubsite.sigmaai.au keeps and the
    # other site's pages send to; here, the app answers 404.  The only POSTs the
    # site takes: a reader's name and first answers, at most 16 KB (819 answers
    # come to about 12), 10 a minute, as a reader finishes a quiz.  Exact
    # matches: a prefix location /quiz/board/ would answer /quiz/board, the
    # board's page, with a 301 (trap 19).  The addresses stay in memory only,
    # for the limit, as /search's do.
    location = /quiz/board/join {
        client_max_body_size 16k;
        limit_req zone=ubsite_board burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }
    location = /quiz/board/answers {
        client_max_body_size 16k;
        limit_req zone=ubsite_board burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    # Static names are NOT content-addressed: /static/ub.css is the same URL
    # after every deploy. So browsers must revalidate. The app sends an ETag and
    # answers 304 when nothing changed, which makes that one small request each.
    # `immutable` belongs here only once the names carry a hash.
    location /static/ {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        add_header Cache-Control "no-cache" always;
        # Compressed on the way, here only: nginx.conf's `gzip on` names no types,
        # so until 2026-10-19 only HTML was.  The fonts are the SBL fonts, which
        # their licence lets us serve only as published, TTF, never WOFF2
        # (build/fonts.py): SBL Greek goes from 1.1 MB to 0.4 MB.  A gzipped
        # reply's ETag is weakened to W/"…", which Starlette's 304 still matches.
        gzip_types text/css text/javascript image/svg+xml font/ttf font/otf;
    }

    # The offline copy's chunks (app.py offline_chunk), which every browser
    # fetches since 2026-11-10, about 48 MB on a first visit.  The app sends each
    # once and nginx keeps it (proxy_cache_path, above); the next browser's is
    # nginx's own file, and Python is not asked.  A chunk is named by the hash
    # of what it holds, so a kept one is never out of date, and what a deploy
    # changes has a new name.  The app says a year (its Cache-Control), which is
    # what nginx goes by; proxy_cache_valid stands in where a reply says nothing.
    #
    #   - The pattern is the app's RE_CHUNK (tests/test_nginx.py holds the two
    #     together), so nothing but a chunk is kept, and a 404 never is.
    #   - A regex, not the prefix /offline/c/, which would answer /offline/c
    #     with a 301 that the app sends back: trap 19's loop.
    #   - The key is the path alone.  With the query in it, as by default,
    #     ?1, ?2 … would each be kept as one more copy of the same chunk.
    #   - X-Cache says MISS or HIT, to see it working.
    location ~ "^/offline/c/[0-9a-f]{16}\.gz$" {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        proxy_cache ubsite_chunks;
        proxy_cache_key $uri;
        proxy_cache_valid 200 365d;
        proxy_cache_lock on;
        add_header X-Cache $upstream_cache_status;
    }

    # The owner's page of visits (ubsite/stats.py): its password is checked with
    # scrypt, 43 ms and 16 MB a try, so a run of guesses could fill the unit's
    # MemoryMax.  Ten a minute is more than the owner reloads it (review,
    # 2026-11-09).
    location = /stats {
        limit_req zone=ubsite_stats burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }
}
