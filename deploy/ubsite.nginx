# Install as root:root 0644 at /etc/nginx/sites-available/ubsite, then:
#
#     sudo ln -s /etc/nginx/sites-available/ubsite /etc/nginx/sites-enabled/
#     sudo nginx -t && sudo systemctl reload nginx
#
# Two rules this file must not break:
#
#   1. `no-sni-default` is the ONLY default_server on 443. Do not add another
#      here -- nginx refuses to start with a duplicate.
#   2. ub.ddns.net must not also appear in ulib.ddns.net's server_name. Two
#      blocks claiming one name means the first parsed wins, silently.
#
# Unlike ulib and libnodes there is NO allow/deny: this site is meant to be
# public. That is a deliberate change of posture, so the protections that an IP
# allowlist was providing are replaced explicitly below.

limit_req_zone $binary_remote_addr zone=ubsite_search:10m rate=30r/m;

server {
    listen 80;
    server_name ub.ddns.net;
    # Certbot's HTTP-01 challenge needs this to stay reachable; the existing
    # cert renews the same way, which is why port 80 is forwarded at all.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ub.ddns.net;

    ssl_certificate     /etc/letsencrypt/live/ub.ddns.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ub.ddns.net/privkey.pem;

    # The site accepts no uploads of any kind.
    client_max_body_size 1k;

    # Search is the only route that can cost real work; everything else is an
    # indexed SELECT. 30/min with a burst is generous for a reader and useless
    # for a scraper.
    location /search {
        limit_req zone=ubsite_search burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }

    # Fonts and CSS are content-addressed by the build and never change under a
    # given name, so they may be cached hard.
    location /static/ {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8130;
        include /etc/nginx/proxy_params;
    }
}
