# Install as root:root 0644 at /etc/systemd/system/ubsite.service.
#
#     sudo cp deploy/ubsite.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now ubsite
#
# This is a PUBLIC service. It is bound to loopback so nginx is the only door,
# and it is hardened further than libnodes and urantia-library for the same
# reason.

[Unit]
Description=The Urantia Book — the annotated reader
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=tigran
Group=tigran
WorkingDirectory=/home/tigran/ubsite

# No --reload: that is a development watcher. Two workers on four cores leaves
# headroom for the other two services; one would saturate the link anyway.
ExecStart=/home/tigran/ubsite/.venv/bin/uvicorn ubsite.app:app \
    --host 127.0.0.1 --port 8130 --workers 2 --loop uvloop --http httptools

Restart=on-failure
RestartSec=5

# Two malloc arenas to a process, not glibc's eight to a core. Each request runs
# in one of a worker's threads, and every thread that allocates under contention
# gets an arena of its own, which keeps what it freed. Under 32 clients at once
# for three rounds of 25 s, the two workers grew from 144 MB to 975 MB and were
# still growing; with two arenas they levelled off at 656 MB, at the same 190
# pages a second (2026-10-27).
Environment=MALLOC_ARENA_MAX=2

# A leak-catcher, not a budget: about 200 MB RSS at rest, under 700 MB under a
# long burst (above), so 2G leaves room for the features to come. ub.db is read
# through the page cache, which is not charged here.
MemoryMax=2G

# The service reads a database and writes sockets. It needs nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tigran/ubsite/var
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
