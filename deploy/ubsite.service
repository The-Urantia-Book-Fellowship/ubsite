# Install as root:root 0644 at /etc/systemd/system/ubsite.service.
#
#     sudo cp deploy/ubsite.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now ubsite
#
# This is a PUBLIC service, unlike libnodes and urantia-library, which sit behind
# an IP allowlist. It is bound to loopback so nginx is the only door, and it is
# hardened further than they are for the same reason.

[Unit]
Description=The Urantia Book — the annotated reader
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=tigran
Group=tigran
WorkingDirectory=/home/tigran/ubsite

# No --reload: that is a development watcher. Two workers on four cores leaves
# headroom for the other two services; one would saturate the link anyway.
ExecStart=/home/tigran/ubsite/.venv/bin/uvicorn ubsite.app:app \
    --host 127.0.0.1 --port 8130 --workers 2 --loop uvloop --http httptools

Restart=on-failure
RestartSec=5

# A leak-catcher, not a budget: expect ~120 MB RSS. ub.db is read through the
# page cache, which is not charged here.
MemoryMax=1G

# The service reads a database and writes sockets. It needs nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tigran/ubsite/var
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
