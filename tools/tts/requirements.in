# The synthetic voice's own environment -- NOT the site's.  In ~/Software/ml
# (the Makefile's ML) with its model cache; pi5 never needs it.  The output is
# var/audio/ai/ and data/audio/ai.tsv.
#
# Kokoro-82M (Apache-2.0): its English G2P, misaki, takes IPA inline --
# "[Nebadon](/nˈɛbədɑn/)" -- which is what data/pronounce.tsv needs.
kokoro
misaki[en]
soundfile
# Left free, uv resolved kokoro against transformers 4.12, whose tokenizers
# needs a Rust build; any current release will do.
transformers>=4.45
# misaki needs spaCy's small English model and otherwise tries to fetch it at
# run time, through a `pip` that is not there.
en_core_web_sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
