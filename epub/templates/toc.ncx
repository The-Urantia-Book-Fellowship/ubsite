<?xml version="1.0" encoding="UTF-8"?>
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="en-US">
<head>
<meta name="dtb:uid" content="{{ uid }}"/>
<meta name="dtb:depth" content="{{ depth }}"/>
<meta name="dtb:totalPageCount" content="0"/>
<meta name="dtb:maxPageNumber" content="0"/>
</head>
<docTitle><text>The Urantia Book</text></docTitle>
<navMap>
{% macro points(nodes) %}
{% for n in nodes %}
<navPoint id="{{ n.id }}" playOrder="{{ n.order }}"><navLabel><text>{{ n.label }}</text></navLabel><content src="{{ n.href }}"/>
{% if n.kids %}{{ points(n.kids) }}{% endif %}
</navPoint>
{% endfor %}
{% endmacro %}
{{ points(toc) }}
</navMap>
</ncx>
